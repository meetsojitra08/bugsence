            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project\": \"{{project_id}}\",\n  \"title\": \"Fix race condition in token refresh\",\n  \"description\": \"Simultaneous requests cause 401 unhandled logout\",\n  \"status\": \"todo\",\n  \"priority\": \"urgent\",\n  \"severity\": \"critical\",\n  \"type\": \"bug\"\n}"
            },
            "url": { "raw": "{{base_url}}/issues/", "host": ["{{base_url}}"], "path": ["issues", ""] }
          }
        },
