            "url": {
              "raw": "{{base_url}}/issues/?status=in_progress&priority=urgent",
              "host": ["{{base_url}}"],
              "path": ["issues", ""],
              "query": [
                { "key": "status", "value": "in_progress" },
                { "key": "priority", "value": "urgent" }
              ]
            }
          }
        },
        {
          "name": "Create Issue",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
