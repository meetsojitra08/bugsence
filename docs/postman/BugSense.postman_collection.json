              "raw": "{\n  \"status\": \"in_progress\",\n  \"target_prev_id\": null,\n  \"target_next_id\": null\n}"
            },
            "url": { "raw": "{{base_url}}/issues/{{issue_id}}/move/", "host": ["{{base_url}}"], "path": ["issues", "{{issue_id}}", "move", ""] }
